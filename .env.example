# Servidor
PORT=3000

# Base de datos
# Hoy (MongoDB, se retira al terminar la migración):
DB_CONECT=mongodb+srv://usuario:password@cluster.mongodb.net/variedades
# Objetivo (PostgreSQL en Neon, requiere SSL):
DATABASE_URL=postgresql://usuario:password@host.neon.tech/variedades?sslmode=require

# Autenticación
SECRET_JWT_SEED=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Cloudinary
CLOUDINARY_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:5173
