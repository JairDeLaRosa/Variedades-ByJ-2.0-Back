# Servidor
NODE_ENV=development
PORT=3000

# PostgreSQL (Neon). `neon env pull` rellena estas variables en .env.local.
# DATABASE_URL: conexión con pooler, la usa la app.
DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED: conexión directa, la usan las migraciones.
DATABASE_URL_UNPOOLED=postgresql://usuario:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# false solo para un Postgres local sin SSL
DB_SSL=true
# Tamaño máximo del pool de conexiones
DB_POOL_MAX=5

# Autenticación (mínimo 16 caracteres)
SECRET_JWT_SEED=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Cloudinary
CLOUDINARY_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# CORS: orígenes permitidos separados por coma.
# En producción pon aquí la URL del frontend desplegado.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Swagger en /api (déjalo en false en producción)
SWAGGER_ENABLED=false

# Saltos de proxy delante de la API (0 en local; 3 en Render). Define de dónde se lee la
# IP real del visitante para el límite de intentos de login.
TRUST_PROXY=0
